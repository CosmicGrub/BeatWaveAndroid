<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase 7: declares which directories the FileProvider (see
  AndroidManifest.xml) is allowed to mint content:// Uris into.
  cache-path/name="exports" matches ArrangementViewModel's
  EXPORTS_DIR_NAME ("exports", under cacheDir) exactly: the only
  directory an exported WAV is ever written to.

  Post-v1 audit A2: files-path/name="crash_logs" matches CrashLogger's
  CRASH_LOGS_DIR_NAME ("crash_logs", under filesDir, persistent app
  storage, not cacheDir, since crash logs must survive across app restarts)
  so the "Crash Logs" diagnostics sheet can share an individual report the
  same way project export already shares a WAV.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="exports" path="exports/" />
    <files-path name="crash_logs" path="crash_logs/" />
</paths>
