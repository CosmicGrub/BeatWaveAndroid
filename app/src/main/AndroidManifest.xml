<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      RECORD_AUDIO is declared now because Phase 0 stands up the native
      audio module (which needs the permission to open an input stream for
      later full-duplex testing). The runtime permission request/UI flow
      itself is built in Phase 5.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      Phase 6: background playback via a MediaSessionService. FOREGROUND_SERVICE
      and FOREGROUND_SERVICE_MEDIA_PLAYBACK are required to run a media-playback
      foreground service on API 34+ (targetSdk 35 here); POST_NOTIFICATIONS is
      the API 33+ runtime permission needed to actually show the media
      notification (requested at point of use when playback first starts,
      see ArrangementScreen; the foreground service itself still runs, and
      playback still works, without it; only the visible notification surface
      is affected).
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".BeatWaveApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              Phase 7: lets BeatWave show up in other apps' share sheets as
              an import target ("the app can receive shared audio files as
              import candidates", per the design spec); see
              MainActivity.handleShareIntent. Deliberately plain "standard"
              launch mode, not singleTask: BeatWaveApplication's app-wide
              PlaybackEngine singleton (Phase 6) means a second MainActivity
              instance existing briefly is harmless (both instances read/
              drive the SAME underlying state), and singleTask would let
              ActivityScenario.launch(MainActivity::class.java) in
              instrumented tests silently reuse AndroidJUnitRunner's own
              pre-test warm-up MainActivity instance instead of a fresh one:
              a real bug this exact tradeoff caused during Phase 7's own
              on-device verification (see ExportShareTest). onNewIntent below
              still exists as a defensive no-cost handler for the rarer cases
              Android redelivers to an existing standard-launch-mode instance
              anyway (e.g. a caller-set FLAG_ACTIVITY_SINGLE_TOP).
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <!--
          Phase 6: wraps PlaybackEngine (see com.beatwave.android.audio) in a
          Media3 MediaSessionService for lock-screen/notification transport
          controls and background playback survival. Not exported to other
          apps (no Android Auto/Wear OS companion in scope for v1); the
          intent-filter below is what lets the OS media-session framework
          (and this app's own startForegroundService call) discover it.
        -->
        <service
            android:name=".audio.BeatWavePlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!--
          Phase 7: grants the receiving app in the share sheet temporary
          read access to a WAV file under cacheDir/exports/ via a content://
          Uri (see ArrangementScreen's outgoing-share LaunchedEffect);
          exported="false" plus grantUriPermissions is the standard
          FileProvider pattern, since a raw file:// Uri would throw
          FileUriExposedException on API 24+. res/xml/file_paths.xml
          declares which directory is shared.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
