<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      RECORD_AUDIO is declared now because Phase 0 stands up the native
      audio module (which needs the permission to open an input stream for
      later full-duplex testing). The runtime permission request/UI flow
      itself is built in Phase 5.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      Phase 6: background playback via a MediaSessionService. FOREGROUND_SERVICE
      and FOREGROUND_SERVICE_MEDIA_PLAYBACK are required to run a media-playback
      foreground service on API 34+ (targetSdk 35 here); POST_NOTIFICATIONS is
      the API 33+ runtime permission needed to actually show the media
      notification (requested at point of use when playback first starts,
      see ArrangementScreen; the foreground service itself still runs, and
      playback still works, without it; only the visible notification surface
      is affected).
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".BeatWaveApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Phase 6: wraps PlaybackEngine (see com.beatwave.android.audio) in a
          Media3 MediaSessionService for lock-screen/notification transport
          controls and background playback survival. Not exported to other
          apps (no Android Auto/Wear OS companion in scope for v1); the
          intent-filter below is what lets the OS media-session framework
          (and this app's own startForegroundService call) discover it.
        -->
        <service
            android:name=".audio.BeatWavePlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
